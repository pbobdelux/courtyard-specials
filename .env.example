# ---- Copy this file to .env.local and fill in values ----
# Everything is OPTIONAL for local testing. With nothing set, the app
# stores data in a local file (.data/special.json) and skips auth.

# Restaurant name shown on the board and in social captions
RESTAURANT_NAME="Courtyard"

# Password the owner types once on the phone admin page
ADMIN_PASSWORD="change-me"

# Public URL of the deployed site (used to build the social image link).
# On Vercel this is set automatically; only needed if it guesses wrong.
PUBLIC_BASE_URL="https://your-site.vercel.app"

# ---- Upstash Redis (free) — required in production ----
# Get these from the Upstash integration in the Vercel dashboard,
# or from console.upstash.com. Either naming works.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Make.com bridge ----
# A random secret string. Make sends this so only Make can read/post.
MAKE_TOKEN="make-a-long-random-string"

# ---- Slack ----
SLACK_SIGNING_SECRET=""
# Bot token (starts with xoxb-) — required for the proof loop to post into Slack
SLACK_BOT_TOKEN=""

# ---- AI editing (the Slack proof loop) ----
# From console.anthropic.com. Powers plain-English board edits.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to the small, cheap model)
AI_MODEL="claude-haiku-4-5"

# ---- AI image generation (Gemini) ----
# From aistudio.google.com. Powers AI backgrounds + full AI boards.
GEMINI_API_KEY=""
# Optional model override
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# Vercel Blob token — auto-added when you create a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=""
